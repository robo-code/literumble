[Unit]
Description=LiteRumble (SQLite/gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/literumble
Environment=LITERUMBLE_DB=/opt/literumble/data/literumble.db
# Single worker is mandatory: memcache dict, global_dict, the task-queue worker
# and the scheduler are in-process singletons. Scale with threads only.
ExecStart=/opt/literumble/venv/bin/gunicorn wsgi_local:app \
    -b 127.0.0.1:8081 --workers 1 --threads 16 --timeout 60
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
